# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Type-aware bug finder for OCaml"
description:
  "ochk reads the typed .cmt files dune produces and reports likely bugs that need type information to find. Its first rules catch polymorphic comparison (=, compare, List.mem, Hashtbl.hash, ...) on functions, on abstract types such as Map and Hashtbl, and optionally in generic code."
maintainer: ["junj-st"]
authors: ["ostd contributors"]
license: "MIT"
homepage: "https://github.com/junj-st/ochk"
bug-reports: "https://github.com/junj-st/ochk/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "5.3.0" & < "5.4"}
  "ostd" {with-test}
  "ocamlfind" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/junj-st/ochk.git"
