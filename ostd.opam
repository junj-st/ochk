# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A drop-in extension of the OCaml standard library"
description:
  "ostd extends Stdlib without replacing it: extra List, String, Option, Result, Map and Set functions, persistent Heap and Deque, and an opt-in Safe module that shadows polymorphic comparison."
maintainer: ["junj-st"]
authors: ["ostd contributors"]
license: "MIT"
homepage: "https://github.com/junj-st/ochk"
bug-reports: "https://github.com/junj-st/ochk/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "5.3.0"}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/junj-st/ochk.git"
