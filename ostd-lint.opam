# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A linter that catches polymorphic-comparison bugs in OCaml code"
description:
  "ostd-lint reads the .cmt files dune produces and flags polymorphic comparison (=, compare, List.mem, Hashtbl.hash, ...) on functions, abstract types such as Map and Hashtbl, and optionally generic code."
maintainer: ["junj-st"]
authors: ["ostd contributors"]
license: "MIT"
homepage: "https://github.com/junj-st/ostd"
bug-reports: "https://github.com/junj-st/ostd/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "5.3.0" & < "5.4"}
  "ostd" {with-test}
  "ocamlfind" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/junj-st/ostd.git"
